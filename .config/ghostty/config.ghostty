macos-titlebar-style = native
macos-non-native-fullscreen = visible-menu

mouse-hide-while-typing = true

window-width = 96
window-height = 28
adjust-cell-height = 30%

font-family = "Berkeley Mono"
font-size = 13
font-thicken = true
font-feature = -calt
font-feature = -liga
font-feature = -dlig

term = xterm-256color
