{
  // general / workbench
  "window.autoDetectHighContrast": false,
  "window.commandCenter": false,
  "window.confirmBeforeClose": "always",
  "window.systemColorTheme": "auto",

  "workbench.activityBar.location": "top",
  "workbench.browser.showInTitleBar": true,
  "workbench.colorCustomizations": {
    "editorCursor.foreground": "#FF4D00",
    "editor.lineHighlightBackground": "#303239"
  },
  "workbench.colorTheme": "Dark Modern",
  "workbench.diffEditorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "workbench.editor.customLabels.patterns": {
    "*/**/{index,page,route,styles}.{js,jsx,ts,tsx,mdx,css}": "${dirname}.${extname}"
  },
  "workbench.layoutControl.enabled": false,
  "workbench.list.smoothScrolling": true,
  "workbench.navigationControl.enabled": false,
  "workbench.preferredLightColorTheme": "Light+",
  "workbench.startupEditor": "none",

  // editor
  "editor.accessibilitySupport": "off",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "Berkeley Mono",
  "editor.fontLigatures": false,
  "editor.fontSize": 14,
  "editor.fontWeight": "600",
  "editor.formatOnSave": true,
  "editor.inlayHints.fontFamily": "Berkeley Mono",
  "editor.inlineSuggest.fontFamily": "Berkeley Mono",
  "editor.linkedEditing": true,
  "editor.matchBrackets": "near",
  "editor.minimap.renderCharacters": false,
  "editor.smoothScrolling": true,
  "editor.unicodeHighlight.allowedCharacters": {
    "’": true
  },
  "editor.wordWrap": "on",

  // language / linting
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "js/ts.inlayHints.parameterNames.enabled": "all",

  // explorer
  "explorer.compactFolders": false,

  // terminal
  "terminal.integrated.fontSize": 13,

  // chat
  "chat.agent.enabled": true,
  "chat.editor.fontFamily": "Berkeley Mono",
  "chat.viewSessions.orientation": "stacked",

  // copilot
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.selectedCompletionModel": "",

  // markdown
  "markdown.preview.fontFamily": "",

  // extensions
  "cSpell.userWords": [
    "Ampofo",
    "circ",
    "color",
    "colors",
    "kelvinampofo",
    "lerp",
    "lerped",
    "nums",
    "sidenote",
    "squircle",
    "srgb",
    "Vite",
    "WCAG"
  ],

  // other
  "debug.breakpointsView.presentation": "tree",
  "diffEditor.ignoreTrimWhitespace": false
}
