#!/usr/bin/env bash

set -eu

. "$(dirname "${BASH_SOURCE[0]}")/lib"

unstow_packages() {
	# --delete removes the symlinks Stow owns, but leaves the repo files alone.
	if (cd "$repo_root" && stow --delete "${packages[@]}"); then
		ok "unstowed ${packages[*]}"
	else
		warn "could not unstow ${packages[*]}"
	fi
}

section "Links"
unstow_packages

finish "Uninstall complete." "Uninstall completed with warnings."
