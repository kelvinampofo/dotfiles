#!/usr/bin/env bash

set -eu

. "$(dirname "${BASH_SOURCE[0]}")/lib"

unlink_entry() {
	local source="$repo_root/$1"
	local target="$2"
	local actual

	if [ ! -L "$target" ]; then
		warn "$target is not a symlink"
		return
	fi

	actual="$(readlink "$target")"
	if [ "$actual" != "$source" ]; then
		warn "$target points to $actual"
		return
	fi

	if rm "$target"; then
		ok "removed $target"
	else
		warn "could not remove $target"
	fi
}

section "Links"
each_manifest_entry unlink_entry

finish "Uninstall complete." "Uninstall completed with warnings."
