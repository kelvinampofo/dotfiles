#!/usr/bin/env bash

set -eu

. "$(dirname "${BASH_SOURCE[0]}")/lib"

check_command() {
	local name="$1"
	local path

	if path="$(command -v "$name")"; then
		ok "$name -> $path"
	else
		warn "$name is not on PATH"
	fi
}

check_file() {
	local path="$1"

	if [ -e "$repo_root/$path" ]; then
		ok "$path"
	else
		warn "$path is missing"
	fi
}

check_brew_bundle() {
	local output

	if output="$(brew bundle check --verbose --file="$repo_root/Brewfile" 2>&1)"; then
		ok "Brewfile bundle is satisfied"
	else
		warn "Brewfile bundle needs attention"
		printf '%s\n' "$output" | sed 's/^/         /'
	fi
}

check_link() {
	local source="$repo_root/$1"
	local target="$2"
	local actual

	if [ ! -e "$source" ]; then
		warn "$1 is missing"
		return
	fi

	if [ -L "$target" ]; then
		actual="$(readlink "$target")"

		if [ "$actual" = "$source" ]; then
			ok "$target -> $1"
		else
			warn "$target points to $actual"
		fi
	elif [ -e "$target" ]; then
		warn "$target exists but is not a symlink"
	else
		warn "$target is not linked"
	fi
}

section "Tools"
for command_name in brew fish git; do
	check_command "$command_name"
done

section "Files"
check_file "Brewfile"
check_file "links.manifest"

section "Homebrew"
check_brew_bundle

section "Links"
each_manifest_entry check_link

finish "All checks passed." "Some checks need attention."
