#!/usr/bin/env bash

set -u

repo_root="$(git -C "$(dirname "${BASH_SOURCE[0]}")/.." rev-parse --show-toplevel)"
status=0

if [ -t 1 ]; then
	green="$(tput setaf 2)"
	yellow="$(tput setaf 3)"
	bold="$(tput bold)"
	reset="$(tput sgr0)"
else
	green=""
	yellow=""
	bold=""
	reset=""
fi

section() {
	printf '\n%s%s%s\n' "$bold" "$1" "$reset"
}

ok() {
	printf '  %s[ok]%s   %s\n' "$green" "$reset" "$1"
}

warn() {
	printf '  %s[warn]%s %s\n' "$yellow" "$reset" "$1"
	status=1
}

check_command() {
	local name="$1"
	local path

	if path="$(command -v "$name")"; then
		ok "$name -> $path"
	else
		warn "$name is not on PATH"
	fi
}

check_file() {
	local path="$1"

	if [ -e "$repo_root/$path" ]; then
		ok "$path"
	else
		warn "$path is missing"
	fi
}

check_link() {
	local source="$repo_root/$1"
	local target="$2"
	local actual

	if [ ! -e "$source" ]; then
		warn "$1 is missing"
		return
	fi

	if [ -L "$target" ]; then
		actual="$(readlink "$target")"

		if [ "$actual" = "$source" ]; then
			ok "$target -> $1"
		else
			warn "$target points to $actual"
		fi
	elif [ -e "$target" ]; then
		warn "$target exists but is not a symlink"
	else
		warn "$target is not linked"
	fi
}

section "Tools"
for command_name in brew fish git; do
	check_command "$command_name"
done

section "Files"
check_file "Brewfile"

section "Links"
check_link ".gitconfig" "$HOME/.gitconfig"
check_link ".config/fish/config.fish" "$HOME/.config/fish/config.fish"
check_link ".config/fish/functions/fish_prompt.fish" "$HOME/.config/fish/functions/fish_prompt.fish"
check_link ".config/fish/functions/fish_right_prompt.fish" "$HOME/.config/fish/functions/fish_right_prompt.fish"
check_link ".config/fish/functions/fish_greeting.fish" "$HOME/.config/fish/functions/fish_greeting.fish"
check_link ".config/fish/functions/v.fish" "$HOME/.config/fish/functions/v.fish"
check_link ".config/ghostty/config.ghostty" "$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"
check_link ".vscode/settings.json" "$HOME/Library/Application Support/Code/User/settings.json"

printf '\n'
if [ "$status" -eq 0 ]; then
	printf '%sAll checks passed.%s\n' "$green" "$reset"
else
	printf '%sSome checks need attention.%s\n' "$yellow" "$reset"
fi

exit "$status"
