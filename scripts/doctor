#!/usr/bin/env bash

set -eu

. "$(dirname "${BASH_SOURCE[0]}")/lib"

check_command() {
	local name="$1"
	local path

	if path="$(command -v "$name")"; then
		ok "$name -> $path"
	else
		warn "$name is not on PATH"
	fi
}

check_file() {
	local path="$1"

	if [ -e "$repo_root/$path" ]; then
		ok "$path"
	else
		warn "$path is missing"
	fi
}

check_brew_bundle() {
	local output

	if output="$(brew bundle check --verbose --file="$repo_root/Brewfile" 2>&1)"; then
		ok "Brewfile bundle is satisfied"
	else
		warn "Brewfile bundle needs attention"
		printf '%s\n' "$output" | sed 's/^/         /'
	fi
}

resolve_link_target() {
	local link="$1"
	local target="$2"

	if [[ "$target" = /* ]]; then
		printf '%s\n' "$target"
	else
		# Stow usually creates relative symlinks, so resolve them before comparing.
		printf '%s/%s\n' "$(cd "$(dirname "$link")/$(dirname "$target")" && pwd -P)" "$(basename "$target")"
	fi
}

check_link() {
	local source="$1"
	local target="$2"
	local label="$3"
	local actual
	local actual_path

	if [ ! -e "$source" ]; then
		warn "$label is missing"
		return
	fi

	if [ -L "$target" ]; then
		actual="$(readlink "$target")"
		actual_path="$(resolve_link_target "$target" "$actual")"

		if [ "$actual_path" = "$source" ]; then
			ok "$target -> $label"
		else
			warn "$target points to $actual"
		fi
	elif [ -e "$target" ]; then
		warn "$target exists but is not a symlink"
	else
		warn "$target is not linked"
	fi
}

section "Tools"
for command_name in brew fish git stow; do
	check_command "$command_name"
done

section "Files"
check_file "Brewfile"

section "Homebrew"
check_brew_bundle

section "Links"
each_package_file check_link

finish "All checks passed." "Some checks need attention."
