#!/usr/bin/env bash

# Resolve the repo root from this file so scripts can be run from any directory.
repo_root="$(git -C "$(dirname "${BASH_SOURCE[0]}")/.." rev-parse --show-toplevel)"
status=0

# Each name here is a GNU Stow package: files inside the package are linked
# into the same relative path under $HOME.
packages=(
	git
	fish
	ghostty
	vscode
)

# Only use terminal formatting when output is going straight to a terminal
if [ -t 1 ]; then
	green="$(tput setaf 2)"
	yellow="$(tput setaf 3)"
	bold="$(tput bold)"
	reset="$(tput sgr0)"
else
	green=""
	yellow=""
	bold=""
	reset=""
fi

section() {
	printf '\n%s%s%s\n' "$bold" "$1" "$reset"
}

ok() {
	printf '  %s[ok]%s   %s\n' "$green" "$reset" "$1"
}

warn() {
	printf '  %s[warn]%s %s\n' "$yellow" "$reset" "$1"
	# Keep going after a warning, but make the script exit non-zero.
	status=1
}

each_package_file() {
	local callback="$1"
	local package
	local path
	local relative_path
	local target

	for package in "${packages[@]}"; do
		# -print0 and read -d '' keep paths safe even when they contain spaces.
		while IFS= read -r -d '' path; do
			relative_path="${path#"$repo_root/$package/"}"
			target="$HOME/$relative_path"
			# Call the function name passed in as [callback] with source, target,
			# and a human-readable label.
			"$callback" "$path" "$target" "$package/$relative_path"
		done < <(find "$repo_root/$package" -type f -print0)
	done
}

finish() {
	local success="$1"
	local failure="$2"

	printf '\n'
	if [ "$status" -eq 0 ]; then
		printf '%s%s%s\n' "$green" "$success" "$reset"
	else
		printf '%s%s%s\n' "$yellow" "$failure" "$reset"
	fi

	exit "$status"
}
