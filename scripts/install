#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git -C "$(dirname "${BASH_SOURCE[0]}")/.." rev-parse --show-toplevel)"
status=0

link_entry() {
	local source="$1"
	local target="$2"

	mkdir -p "$(dirname "$target")"

	if [ -e "$target" ] && [ ! -L "$target" ]; then
		printf 'Refusing to replace %s because it is not a symlink. Back it up first.\n' "$target" >&2
		status=1
		return
	fi

	ln -sfn "$source" "$target"
	printf 'Linked %s -> %s\n' "$target" "$source"
}

link_entry "$repo_root/.gitconfig" "$HOME/.gitconfig"
link_entry "$repo_root/.config/fish/config.fish" "$HOME/.config/fish/config.fish"
link_entry "$repo_root/.config/fish/functions/fish_prompt.fish" "$HOME/.config/fish/functions/fish_prompt.fish"
link_entry "$repo_root/.config/fish/functions/fish_right_prompt.fish" "$HOME/.config/fish/functions/fish_right_prompt.fish"
link_entry "$repo_root/.config/fish/functions/fish_greeting.fish" "$HOME/.config/fish/functions/fish_greeting.fish"
link_entry "$repo_root/.config/ghostty/config.ghostty" "$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"
link_entry "$repo_root/.vscode/settings.json" "$HOME/Library/Application Support/Code/User/settings.json"

exit "$status"
