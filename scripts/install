#!/usr/bin/env bash

set -eu

. "$(dirname "${BASH_SOURCE[0]}")/lib"

remove_legacy_link() {
	local source="$1"
	local target="$2"
	local label="$3"
	local actual

	if [ ! -L "$target" ]; then
		return
	fi

	# Remove old repo-root links before Stow creates package links.
	actual="$(readlink "$target")"
	if [[ "$actual" != "$repo_root/"* ]] || [ "$actual" = "$source" ]; then
		return
	fi

	if rm "$target"; then
		ok "removed legacy link $target -> $actual"
	else
		warn "could not remove legacy link $target -> $label"
	fi
}

stow_packages() {
	# --restow refreshes existing links and creates any missing ones.
	if (cd "$repo_root" && stow --restow "${packages[@]}"); then
		ok "stowed ${packages[*]}"
	else
		warn "could not stow ${packages[*]}"
	fi
}

section "Links"
each_package_file remove_legacy_link
stow_packages

finish "Install complete." "Install completed with warnings."
