#!/usr/bin/env bash

set -eu

. "$(dirname "${BASH_SOURCE[0]}")/lib"

backup_root="$HOME/.dotfiles-backups/$(date +%Y%m%d-%H%M%S)"

backup_entry() {
	local target="$1"
	local relative_path
	local backup

	if [[ "$target" == "$HOME/"* ]]; then
		relative_path="${target#"$HOME"/}"
	else
		relative_path="${target#/}"
	fi

	backup="$backup_root/$relative_path"

	if ! mkdir -p "$(dirname "$backup")"; then
		warn "could not create backup directory for $target"
		return 1
	fi

	if mv "$target" "$backup"; then
		ok "backed up $target -> $backup"
	else
		warn "could not back up $target"
		return 1
	fi
}

link_entry() {
	local source="$repo_root/$1"
	local target="$2"

	if [ ! -e "$source" ]; then
		warn "$1 is missing"
		return
	fi

	if ! mkdir -p "$(dirname "$target")"; then
		warn "could not create $(dirname "$target")"
		return
	fi

	if [ -e "$target" ] && [ ! -L "$target" ]; then
		backup_entry "$target" || return
	fi

	if ln -sfn "$source" "$target"; then
		ok "$target -> $1"
	else
		warn "could not link $target -> $1"
	fi
}

section "Links"
each_manifest_entry link_entry

finish "Install complete." "Install completed with warnings."
