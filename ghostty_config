macos-titlebar-style = native

# window
window-width = 88
window-height = 24
window-color-space = display-p3
adjust-cell-height = 30%

# font
font-family = "Berkeley Mono"
font-size = 13
font-thicken = true
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# behaviour
mouse-hide-while-typing = true

# terminal
term = xterm-256color